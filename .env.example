# ============================================================
# II-Agent Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# See docs/knowledge_base/03_environment/ENV_REFERENCE.md for details.

# ============================================================
# CORE (Required)
# ============================================================

# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://ii_agent:password@localhost:5432/ii_agent

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# ============================================================
# LLM PROVIDERS (at least one required)
# ============================================================

# Anthropic (Claude) — primary LLM provider
ANTHROPIC_API_KEY=

# OpenAI (GPT) — alternative provider
OPENAI_API_KEY=

# Google (Gemini) — alternative provider
GOOGLE_API_KEY=

# ============================================================
# SKILLS — Market Newsletter
# ============================================================

# NewsAPI.org key (free tier: 100 requests/day)
# Get one at: https://newsapi.org/register
NEWSAPI_KEY=

# ============================================================
# SKILLS — Health Dashboard (WHOOP)
# ============================================================

# WHOOP OAuth credentials
# Register at: https://developer.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_ACCESS_TOKEN=

# ============================================================
# SKILLS — Daily Investment Newsletter
# ============================================================

# Brave Search API key
# Get one at: https://brave.com/search/api/
BRAVE_API_KEY=

# ============================================================
# EMAIL (for newsletter delivery)
# ============================================================

# Gmail SMTP (use App Password, not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# ============================================================
# STORAGE (optional — for cloud file storage)
# ============================================================

# Google Cloud Storage bucket for skill outputs
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# Local file storage path
FILE_STORE_PATH=/tmp/ii_agent_files

# ============================================================
# SERVICES (optional)
# ============================================================

# E2B sandbox API key (for code execution)
# Get one at: https://e2b.dev
E2B_API_KEY=

# Internal service ports
MCP_PORT=1236
CODEX_PORT=3284

# ============================================================
# INFRASTRUCTURE
# ============================================================

# Logging
LOG_LEVEL=INFO
ENVIRONMENT=development

# Virtual display for Playwright (headless browser)
DISPLAY=:99
